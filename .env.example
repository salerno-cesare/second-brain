# Cartella base della wiki locale
WIKI_SOURCE_DIR=./knowledge

# Fonti originali e wiki compilata, secondo il pattern raw/wiki
WIKI_RAW_DIR=./knowledge/raw
WIKI_OUTPUT_DIR=./knowledge/wiki

# Codex CLI usato come LLM manutentore della wiki.
# Su Windows usa codex.cmd per evitare blocchi ExecutionPolicy sullo shim .ps1.
# La web app lo avvia tramite la shell locale, non dentro Docker.
CODEX_COMMAND=codex.cmd
CODEX_SHELL=powershell
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=900
# 0 = nessun limite: gli estratti in knowledge/.codex_sources/ non vengono troncati.
CODEX_SOURCE_CHAR_LIMIT=0

# Host/porta applicazione
APP_HOST=127.0.0.1
APP_PORT=8000
