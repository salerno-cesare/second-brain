# Cartella base della knowledge base locale
WIKI_SOURCE_DIR=./knowledge

# Fonti originali e wiki pubblicata, secondo il pattern raw/wiki
WIKI_RAW_DIR=./knowledge/raw
WIKI_OUTPUT_DIR=./knowledge/wiki

# Graphify genera graphify-out/ dentro questa cartella.
GRAPHIFY_OUTPUT_DIR=./knowledge
GRAPHIFY_RUNNER=cli
GRAPHIFY_CLI_COMMAND=codex.cmd
GRAPHIFY_TIMEOUT_SECONDS=1800

# Opzionali per GRAPHIFY_RUNNER=headless: selezione backend/modello e tuning runtime Graphify.
# In modalità cli non servono API key Graphify: viene usata la CLI configurata sopra.
GRAPHIFY_BACKEND=
GRAPHIFY_MODEL=
GRAPHIFY_MAX_WORKERS=
GRAPHIFY_TOKEN_BUDGET=
GRAPHIFY_MAX_CONCURRENCY=

# Imposta almeno una chiave supportata da Graphify per fonti non-code
# o passa GRAPHIFY_BACKEND verso un backend configurato.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=

# Host/porta applicazione
APP_HOST=127.0.0.1
APP_PORT=8000
